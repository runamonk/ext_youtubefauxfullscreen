{
  "manifest_version": 3,
  "name": "Youtube Faux Fullscreen",
  "description": "Make a YouTube video fill the browser window without entering native fullscreen.",
  "version": "1.0.28",
  "action": {
    "default_title": "Open Faux fullscreen options",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*"
      ],
      "css": [
        "youtube.css"
      ],
      "js": [
        "extension-api.js",
        "settings.js",
        "youtube.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
